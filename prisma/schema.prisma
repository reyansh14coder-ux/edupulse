generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String
  phone     String?
  title     String?
  createdAt DateTime @default(now())

  student        Student?
  teaching       TeacherAssignment[]
  children       ParentLink[]        @relation("parent")
  guided         GuidanceNote[]      @relation("guideAuthor")
  counseling     CounselingSession[] @relation("counselor")
  homeworks      Homework[]
  interventions  StudentIntervention[] @relation("interventionAuthor")
  feedbackAuthored TeacherFeedback[]  @relation("feedbackAuthor")
  feedbackAbout    TeacherFeedback[]  @relation("feedbackAbout")
  noticesAuthored  Notice[]           @relation("noticeAuthor")
  queriesAnswered  ParentQuery[]      @relation("queryResponder")
  queriesRaised    ParentQuery[]      @relation("queryAuthor")
  weeklyNotes      TeacherWeeklyReport[]
  competitions     Competition[]      @relation("competitionAuthor")
  timetableSlots   TimetableSlot[]
  substitutionsMade Substitution[]    @relation("subOriginal")
  substitutionsCovered Substitution[] @relation("subSubstitute")
  lessonPlans      LessonPlan[]
  staffProfile     StaffProfile?
  staffLeave       LeaveRequest[]     @relation("staffLeave")
  payroll          PayrollRecord[]    @relation("payroll")
  appraisals       Appraisal[]        @relation("appraisal")
  ticketsRaised    HelpdeskTicket[]   @relation("ticketAuthor")
  ticketsReplied   HelpdeskTicket[]   @relation("ticketResponder")
  chatSent         ChatMessage[]      @relation("chatFrom")
  chatReceived     ChatMessage[]      @relation("chatTo")
}

model SchoolClass {
  id          String   @id @default(cuid())
  name        String
  section     String
  year        String
  board       String   @default("CBSE")
  students    Student[]
  assignments TeacherAssignment[]
  assessments Assessment[]
  homeworks   Homework[]
  chapters    Chapter[]
  quizzes     Quiz[]
  timetableSlots TimetableSlot[]
  substitutions  Substitution[]
  lessonPlans    LessonPlan[]

  @@unique([name, section, year])
}

model TeacherAssignment {
  id          String      @id @default(cuid())
  teacher     User        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId   String
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId     String
  subject     String

  @@unique([teacherId, classId, subject])
}

model Student {
  id            String              @id @default(cuid())
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String              @unique
  schoolClass   SchoolClass         @relation(fields: [classId], references: [id])
  classId       String
  rollNo        Int
  admissionNo   String              @unique
  attendance    Attendance[]
  scores        Score[]
  submissions   HomeworkSubmission[]
  parentLinks   ParentLink[]
  guidance      GuidanceNote[]
  counseling    CounselingSession[]
  attempts      QuizAttempt[]
  recommendations Recommendation[]
  goals         StudentGoal[]
  voices        StudentVoice[]
  interventions StudentIntervention[]
  feedback      StudentFeedback[]
  applications  CompetitionApplication[]
  activities    StudentActivity[]
  transportRoute TransportRoute?  @relation(fields: [transportRouteId], references: [id], onDelete: SetNull)
  transportRouteId String?
  feeInvoices   FeeInvoice[]
  feePayments   FeePayment[]
  bookIssues    BookIssue[]
  leaveRequests LeaveRequest[]
  healthIncidents HealthIncident[]
}

model ParentLink {
  id        String  @id @default(cuid())
  parent    User    @relation("parent", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  @@unique([parentId, studentId])
}

model Attendance {
  id        String  @id @default(cuid())
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  date      DateTime
  status    String
  note      String?

  @@unique([studentId, date])
}

model Assessment {
  id          String      @id @default(cuid())
  title       String
  type        String
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId     String
  subject     String
  date        DateTime
  maxMarks    Int
  scores      Score[]
}

model Score {
  id           String     @id @default(cuid())
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String
  marks        Float

  @@unique([assessmentId, studentId])
}

model Homework {
  id          String              @id @default(cuid())
  title       String
  description String
  kind        String              @default("HOMEWORK")
  schoolClass SchoolClass         @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId     String
  subject     String
  assignedBy  User                @relation(fields: [assignedById], references: [id], onDelete: Cascade)
  assignedById String
  assignedOn  DateTime            @default(now())
  dueDate     DateTime
  submissions HomeworkSubmission[]
}

model Chapter {
  id          String      @id @default(cuid())
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId     String
  subject     String
  title       String
  order       Int

  @@unique([classId, subject, title])
}

model Quiz {
  id          String        @id @default(cuid())
  title       String
  schoolClass SchoolClass   @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId     String
  subject     String
  chapter     String?
  questions   String
  createdById String?
  createdAt   DateTime      @default(now())
  attempts    QuizAttempt[]
}

model QuizAttempt {
  id        String   @id @default(cuid())
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId    String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  score     Int
  total     Int
  detail    String
  createdAt DateTime @default(now())

  @@unique([quizId, studentId])
}

model Recommendation {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  kind      String
  title     String
  body      String
  context   String?
  status    String   @default("NEW")
  plan       String?
  planStatus String   @default("NONE")
  planNote   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentGoal {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  kind      String   @default("GOAL")
  title     String
  note      String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorName String
  action    String
  subject   String?
  detail    String?
  createdAt DateTime @default(now())
}

model HomeworkSubmission {
  id          String    @id @default(cuid())
  homework    Homework  @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  homeworkId  String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  status      String
  submittedOn DateTime?
  remarks     String?

  @@unique([homeworkId, studentId])
}

model GuidanceNote {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  author    User     @relation("guideAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  category  String
  title     String
  body      String
  createdAt DateTime @default(now())
}

model CounselingSession {
  id           String    @id @default(cuid())
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String
  counselor    User      @relation("counselor", fields: [counselorId], references: [id], onDelete: Cascade)
  counselorId  String
  scheduledFor DateTime
  status       String
  notes        String?
}

model StudentVoice {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  mood      String
  note      String?
  createdAt DateTime @default(now())
}

model StudentIntervention {
  id          String    @id @default(cuid())
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  createdBy   User      @relation("interventionAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  title       String
  note        String?
  status      String    @default("ACTIVE")
  outcome     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model TeacherFeedback {
  id         String   @id @default(cuid())
  teacher    User     @relation("feedbackAbout", fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId  String
  author     User?    @relation("feedbackAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorId   String?
  category   String
  body       String
  status     String   @default("NEW")
  createdAt  DateTime @default(now())
}

model StudentFeedback {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  category  String   @default("SUGGESTION")
  subject   String   @default("General")
  body      String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model Notice {
  id          String    @id @default(cuid())
  title       String
  body        String
  audience    String    @default("ALL")
  classId     String?
  createdBy   User?     @relation("noticeAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  authorName  String    @default("Administration")
  createdAt   DateTime  @default(now())
}

model Competition {
  id          String                  @id @default(cuid())
  title       String
  body        String
  deadline    DateTime?
  classId     String?
  createdBy   User?                   @relation("competitionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  authorName  String                  @default("School")
  createdAt   DateTime                @default(now())
  applications CompetitionApplication[]
}

model CompetitionApplication {
  id            String      @id @default(cuid())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  competitionId String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     String
  note          String?
  appliedAt     DateTime    @default(now())

  @@unique([competitionId, studentId])
}

model ParentQuery {
  id           String   @id @default(cuid())
  parent       User     @relation("queryAuthor", fields: [parentId], references: [id], onDelete: Cascade)
  parentId     String
  studentId    String?
  recipient    String   @default("TEACHER")
  subject      String?
  body         String
  status       String   @default("OPEN")
  reply        String?
  repliedById  String?
  repliedBy    User?    @relation("queryResponder", fields: [repliedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TeacherWeeklyReport {
  id        String   @id @default(cuid())
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String
  weekOf    DateTime
  body      String
  createdAt DateTime @default(now())

  @@unique([teacherId, weekOf])
}

model StudentActivity {
  id          String   @id @default(cuid())
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  kind        String   @default("ACTIVITY")
  title       String
  note        String?
  date        DateTime
  createdById String?
  createdAt   DateTime @default(now())
}

// ===== ERP: Timetable & substitution =====

model TimetableSlot {
  id         String      @id @default(cuid())
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId    String
  day        String
  period     Int
  startTime  String
  endTime    String
  subject    String
  room       String?
  teacher    User?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId  String?

  @@unique([classId, day, period])
}

model Substitution {
  id              String   @id @default(cuid())
  schoolClass     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId         String
  date            DateTime
  period          Int
  subject         String
  originalTeacher User     @relation("subOriginal", fields: [originalTeacherId], references: [id], onDelete: Cascade)
  originalTeacherId String
  substituteTeacher User   @relation("subSubstitute", fields: [substituteTeacherId], references: [id], onDelete: Cascade)
  substituteTeacherId String
  reason          String?
  createdAt       DateTime @default(now())
}

model LessonPlan {
  id         String      @id @default(cuid())
  teacher    User        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId  String
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId    String
  subject    String
  weekOf     DateTime
  chapter    String
  objectives String
  activities String
  resources  String?
  status     String      @default("SUBMITTED")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([teacherId, classId, subject, weekOf])
}

// ===== ERP: Fees =====

model FeeHead {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  amount      Float
  frequency   String        @default("MONTHLY")
  invoices    FeeInvoice[]
  payments    FeePayment[]
}

model FeeInvoice {
  id        String     @id @default(cuid())
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  head      FeeHead?   @relation(fields: [headId], references: [id], onDelete: SetNull)
  headId    String?
  title     String
  amount    Float
  dueDate   DateTime
  status    String     @default("PENDING")
  paidOn    DateTime?
  createdAt DateTime   @default(now())
  payments  FeePayment[]
}

model FeePayment {
  id         String   @id @default(cuid())
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  head       FeeHead? @relation(fields: [headId], references: [id], onDelete: SetNull)
  headId     String?
  invoice    FeeInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId  String?
  amount     Float
  period     String
  mode       String   @default("CASH")
  receiptNo  String
  recordedById String?
  paidOn     DateTime @default(now())
}

// ===== ERP: Library =====

model LibraryBook {
  id        String      @id @default(cuid())
  title     String
  author    String
  isbn      String?
  category  String      @default("General")
  shelf     String?
  copies    Int         @default(1)
  available Int         @default(1)
  issues    BookIssue[]
}

model BookIssue {
  id         String       @id @default(cuid())
  book       LibraryBook  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId     String
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  issuedOn   DateTime     @default(now())
  dueOn      DateTime
  returnedOn DateTime?
  status     String       @default("ISSUED")
}

// ===== ERP: Calendar / events =====

model SchoolEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  kind        String   @default("EVENT")
  audience    String   @default("ALL")
  location    String?
  createdById String?
  createdAt   DateTime @default(now())
}

// ===== ERP: Leave =====

model LeaveRequest {
  id           String    @id @default(cuid())
  kind         String    @default("STUDENT")
  student      Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String?
  staff        User?     @relation("staffLeave", fields: [staffId], references: [id], onDelete: Cascade)
  staffId      String?
  from         DateTime
  to           DateTime
  reason       String
  status       String    @default("PENDING")
  reviewedById String?
  note         String?
  createdAt    DateTime  @default(now())
}

// ===== ERP: Transport =====

model TransportRoute {
  id       String    @id @default(cuid())
  name     String
  busNo    String
  driver   String
  phone    String?
  timing   String
  stops    String
  students Student[]
}

// ===== ERP: Gallery =====

model GalleryPhoto {
  id           String   @id @default(cuid())
  title        String
  url          String
  caption      String?
  album        String   @default("General")
  takenOn      DateTime @default(now())
  uploadedById String?
}

// ===== ERP: Front office =====

model VisitorLog {
  id       String    @id @default(cuid())
  name     String
  phone    String?
  purpose  String
  host     String
  inTime   DateTime  @default(now())
  outTime  DateTime?
  status   String    @default("INSIDE")
}

// ===== ERP: Staff profiles =====

model StaffProfile {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String   @unique
  employeeId     String?
  qualification  String?
  experience     String?
  joinedOn       DateTime?
  bio            String?
  emergencyPhone String?
}

// ===== Communication: help desk =====

model HelpdeskTicket {
  id           String   @id @default(cuid())
  raisedBy     User     @relation("ticketAuthor", fields: [raisedById], references: [id], onDelete: Cascade)
  raisedById   String
  role         String
  studentId    String?
  subject      String
  body         String
  category     String   @default("GENERAL")
  status       String   @default("OPEN")
  reply        String?
  repliedById  String?
  repliedBy    User?    @relation("ticketResponder", fields: [repliedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ChatMessage {
  id        String    @id @default(cuid())
  fromId    String
  from      User      @relation("chatFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String?
  to        User?     @relation("chatTo", fields: [toId], references: [id], onDelete: Cascade)
  classId   String?
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

// ===== Admissions =====

model AdmissionEnquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  grade     String
  message   String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

// ===== Surveys =====

model Survey {
  id        String           @id @default(cuid())
  title     String
  question  String
  options   String
  audience  String           @default("ALL")
  closesOn  DateTime?
  createdAt DateTime         @default(now())
  responses SurveyResponse[]
}

model SurveyResponse {
  id           String   @id @default(cuid())
  survey       Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  surveyId     String
  respondentId String
  choice       Int
  createdAt    DateTime @default(now())

  @@unique([surveyId, respondentId])
}

// ===== Competitive exam intelligence =====

model ExamOpportunity {
  id        String   @id @default(cuid())
  name      String
  body      String
  examOn    DateTime?
  deadline  DateTime?
  classes   String?
  link      String?
  createdAt DateTime @default(now())
}

// ===== HRMS =====

model Vacancy {
  id           String          @id @default(cuid())
  title        String
  department   String
  subjects     String?
  vacancies    Int             @default(1)
  description  String?
  status       String          @default("OPEN")
  createdAt    DateTime        @default(now())
  applications JobApplication[]
}

model JobApplication {
  id            String   @id @default(cuid())
  vacancy       Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  vacancyId     String
  name          String
  phone         String
  email         String?
  qualification String?
  experience    String?
  resumeNote    String?
  status        String   @default("NEW")
  createdAt     DateTime @default(now())
}

model PayrollRecord {
  id         String   @id @default(cuid())
  staff      User     @relation("payroll", fields: [staffId], references: [id], onDelete: Cascade)
  staffId    String
  month      String
  basic      Float
  allowances Float    @default(0)
  deductions Float    @default(0)
  net        Float
  status     String   @default("DRAFT")
  paidOn     DateTime?

  @@unique([staffId, month])
}

model Appraisal {
  id          String   @id @default(cuid())
  staff       User     @relation("appraisal", fields: [staffId], references: [id], onDelete: Cascade)
  staffId     String
  period      String
  rating      Float
  strengths   String?
  improvements String?
  createdAt   DateTime @default(now())
}

// ===== Finance & control =====

model BudgetLine {
  id       String  @id @default(cuid())
  category String
  planned  Float
  year     String

  @@unique([category, year])
}

model Expense {
  id           String   @id @default(cuid())
  category     String
  title        String
  amount       Float
  vendor       String?
  status       String   @default("APPROVED")
  spentOn      DateTime @default(now())
  recordedById String?
}

model Vendor {
  id       String @id @default(cuid())
  name     String
  category String
  phone    String?
  status   String @default("ACTIVE")
}

model PurchaseRequest {
  id             String   @id @default(cuid())
  title          String
  category       String
  amount         Float
  requestedById  String?
  requestedByName String  @default("")
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
}

// ===== Health & safety =====

model HealthIncident {
  id        String   @id @default(cuid())
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  title     String
  note      String?
  severity  String   @default("MINOR")
  date      DateTime @default(now())
}

// ===== YouTube learn / resources =====

model LearningResource {
  id       String   @id @default(cuid())
  subject  String
  chapter  String
  title    String
  url      String
  kind     String   @default("VIDEO")
  addedById String?
  createdAt DateTime @default(now())
}

